# resume-forge environment configuration
# Copy to .env and fill in values. Do not commit .env files with real credentials.

# ── Development ports (match architecture-context.md) ──────────────────
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
PROFILE_SERVICE_PORT=4002
RESUME_SERVICE_PORT=4003
STORAGE_SERVICE_PORT=4004
WORKSPACE_SERVICE_PORT=4005

SHELL_DEV_PORT=3000
AUTH_MFE_DEV_PORT=3001
PROFILE_MFE_DEV_PORT=3002
RESUME_MFE_DEV_PORT=3003

# Local PostgreSQL: pnpm db:local:start generates .local/database.env.
# Prisma CLI loads that private file automatically unless DATABASE_URL is set.
# Hosted database/provider selection is deferred.
# DATABASE_URL=postgresql://resume_forge:LOCAL_PASSWORD@127.0.0.1:55432/resume_forge_dev

# ── OAuth providers (resolve D08/D10 before real integration) ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Sessions ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production

# ── Object storage (Cloudflare R2) ────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=resume-forge-dev

# ── AI providers (resolve before Phase 2) ─────────────────────────────
GEMINI_API_KEY=

# ── Background tasks (resolve before Phase 2) ─────────────────────────
TRIGGER_DEV_API_KEY=
TRIGGER_DEV_API_URL=

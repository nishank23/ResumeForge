# Copy to .env. Uncomment only configured settings; keep credentials private.
# Local ports are fixed by scripts/start-personal-dev.mjs and service configs.
# Database and internal service credentials are generated in ignored .local/.
# Do not add VITE_ prefixes to server secrets.

# Google OAuth Web application. Both values must be nonempty when set.
# Authorized redirect: http://localhost:4001/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional Gemini: the backend enables AI only with a key and paid data mode.
# Set paid only for a billed Gemini project.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_DATA_MODE=paid

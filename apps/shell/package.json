{
  "name": "@resume-forge/shell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "preview": "vite preview --port 3000",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@resume-forge/shared": "workspace:*",
    "@resume-forge/shared-types": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@module-federation/vite": "^1.22.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0"
  }
}

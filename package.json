{
  "name": "@resume-forge/root",
  "private": true,
  "description": "resume-forge monorepo — AI resume and professional-profile management platform",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:local:status": "node scripts/local-db.mjs status",
    "db:migrate": "pnpm --filter @resume-forge/prisma-client migrate",
    "db:test": "pnpm --filter @resume-forge/prisma-client test:db",
    "db:test:audit": "pnpm --filter @resume-forge/workspace-service test:db",
    "audit:deliver:local": "pnpm --filter @resume-forge/workspace-service... build && node scripts/deliver-local-audit.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "audit:local:init": "node scripts/init-local-audit.mjs",
    "audit:serve:local": "pnpm --filter @resume-forge/workspace-service... build && node scripts/start-local-audit.mjs"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.11.5",
    "typescript": "^5.8.3"
  }
}

{
  "name": "@resume-forge/root",
  "private": true,
  "description": "resume-forge monorepo \u2014 AI resume and professional-profile management platform",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "task:status": "node scripts/development-task.mjs status",
    "task:start": "node scripts/development-task.mjs start",
    "task:finish": "node scripts/development-task.mjs finish",
    "task:test": "node --test scripts/test/development-task.test.mjs scripts/test/local-vector-config.test.mjs",
    "db:vector:init": "node scripts/init-local-vector.mjs",
    "db:test:vector": "node --test scripts/test/local-vector.test.mjs",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:local:status": "node scripts/local-db.mjs status",
    "db:migrate": "pnpm --filter @resume-forge/prisma-client migrate",
    "db:test": "pnpm --filter @resume-forge/prisma-client test:db",
    "db:test:audit": "pnpm --filter @resume-forge/workspace-service test:db",
    "audit:deliver:local": "pnpm --filter @resume-forge/workspace-service... build && node scripts/deliver-local-audit.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "audit:local:init": "node scripts/init-local-audit.mjs",
    "audit:serve:local": "pnpm --filter @resume-forge/workspace-service... build && node scripts/start-local-audit.mjs",
    "db:runtime:init": "pnpm --filter @resume-forge/prisma-client... build && node scripts/init-runtime-db.mjs",
    "db:test:roles": "pnpm --filter @resume-forge/workspace-service... build && node services/workspace-service/test/runtime-roles.test.mjs",
    "audit:worker:local": "pnpm --filter @resume-forge/workspace-service... build && node scripts/work-local-audit.mjs",
    "auth:local:init": "node scripts/init-local-auth.mjs",
    "db:test:profile": "pnpm --filter @resume-forge/profile-service... --filter @resume-forge/auth-service... --filter @resume-forge/workspace-service... --filter @resume-forge/gateway... -r build && pnpm --filter @resume-forge/profile-service test:db",
    "dev:personal": "pnpm --filter @resume-forge/shared... --filter @resume-forge/auth-service... --filter @resume-forge/profile-service... --filter @resume-forge/resume-service... --filter @resume-forge/ats-service... --filter @resume-forge/gateway... -r build && node scripts/start-personal-dev.mjs"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.11.5",
    "typescript": "^5.8.3"
  }
}

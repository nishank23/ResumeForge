{
  "name": "@resume-forge/prisma-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc --build",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "test:db": "pnpm --filter @resume-forge/audit-contracts... build && pnpm build && node --test test/database.test.mjs",
    "test": "node --test test/runtime-config.test.mjs"
  },
  "dependencies": {
    "@resume-forge/audit-contracts": "workspace:*",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  }
}

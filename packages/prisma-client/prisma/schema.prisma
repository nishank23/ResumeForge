generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  individual
  organization
  vendor
}

enum OAuthProvider {
  google
  linkedin
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @unique
  name              String?
  avatarUrl         String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  accounts          OAuthAccount[]
  sessions          Session[]
  profile           UserProfile?
  personalWorkspace Workspace?
  memberships       WorkspaceMembership[]
}

model OAuthAccount {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  provider        OAuthProvider
  providerSubject String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshHash  String    @unique @db.Char(64)
  familyId     String    @db.Uuid
  replacedById String?   @unique @db.Uuid
  replacement  Session?  @relation("Rotation", fields: [replacedById], references: [id], onDelete: Restrict)
  previous     Session?  @relation("Rotation")
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model Workspace {
  id                  String                  @id @default(uuid()) @db.Uuid
  type                WorkspaceType
  personalOwnerUserId String?                 @unique @db.Uuid
  personalOwner       User?                   @relation(fields: [personalOwnerUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  grants              ProfileWorkspaceGrant[]
  organization        Organization?
  vendor              Vendor?
  memberships         WorkspaceMembership[]
  auditEvents         AuditEvent[]
  jdHistories         JDHistory[]
  resumes             Resume[]
  taskRuns            TaskRun[]
}

model UserProfile {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @unique @db.Uuid
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  fullName              String
  location              String?
  professionalSummary   String?
  revision              Int                     @default(1)
  onboardingCompletedAt DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  contact               UserContact?
  grants                ProfileWorkspaceGrant[]
  educations            Education[]
  experiences           Experience[]
  skills                Skill[]
  projects              UserProject[]
  certifications        Certification[]
  jdHistories           JDHistory[]
  resumes               Resume[]

  @@unique([id, userId])
}

model UserContact {
  id           String      @id @default(uuid()) @db.Uuid
  profileId    String      @unique @db.Uuid
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  email        String?
  phone        String?
  address      String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
}

model ProfileWorkspaceGrant {
  id              String      @id @default(uuid()) @db.Uuid
  profileId       String      @db.Uuid
  workspaceId     String      @db.Uuid
  grantedByUserId String      @db.Uuid
  profile         UserProfile @relation(fields: [profileId, grantedByUserId], references: [id, userId], onDelete: Restrict)
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  canReadProfile  Boolean     @default(false)
  canWriteProfile Boolean     @default(false)
  canReadContact  Boolean     @default(false)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?   @db.Timestamptz(3)

  @@unique([profileId, workspaceId])
  @@index([workspaceId, revokedAt, profileId])
}

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @unique @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  slug        String    @unique
  logoUrl     String?
  settings    Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

model Vendor {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @unique @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  slug        String    @unique
  logoUrl     String?
  settings    Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

model WorkspaceMembership {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        String
  status      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, userId])
}

model Education {
  id           String      @id @default(uuid()) @db.Uuid
  profileId    String      @db.Uuid
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  institution  String
  degree       String
  fieldOfStudy String
  startDate    String?
  endDate      String?
  gpa          String?
  description  String?
  sortOrder    Int         @default(0)

  @@index([profileId])
}

model Experience {
  id           String      @id @default(uuid()) @db.Uuid
  profileId    String      @db.Uuid
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  company      String
  title        String
  location     String?
  startDate    String?
  endDate      String?
  isCurrent    Boolean     @default(false)
  bulletPoints Json?
  keywords     Json?
  metrics      Json?
  sortOrder    Int         @default(0)

  @@index([profileId])
}

model Skill {
  id          String      @id @default(uuid()) @db.Uuid
  profileId   String      @db.Uuid
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  name        String
  category    String
  proficiency String

  @@index([profileId])
}

model UserProject {
  id           String      @id @default(uuid()) @db.Uuid
  profileId    String      @db.Uuid
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  name         String
  description  String
  url          String?
  technologies Json?
  startDate    String?
  endDate      String?

  @@index([profileId])
}

model Certification {
  id            String      @id @default(uuid()) @db.Uuid
  profileId     String      @db.Uuid
  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  name          String
  issuer        String
  issueDate     String?
  expiryDate    String?
  credentialUrl String?

  @@index([profileId])
}

model AuditEvent {
  id            String        @id @default(uuid()) @db.Uuid
  actorUserId   String        @db.Uuid
  workspaceType WorkspaceType
  workspaceId   String        @db.Uuid
  targetUserId  String?       @db.Uuid
  action        String
  resourceType  String
  resourceId    String?
  metadata      Json?
  outcome       String?
  correlationId String?
  payloadHash   String?
  timestamp     DateTime      @default(now()) @db.Timestamptz(3)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, timestamp])
  @@index([actorUserId, timestamp])
}

model AuditOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @unique @db.Uuid
  payload        Json
  deliveryState  String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken     String?   @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  deliveredAt    DateTime? @db.Timestamptz(3)
  lastErrorCode  String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([deliveryState, nextAttemptAt, createdAt])
}

model JDHistory {
  id                     String        @id @default(uuid()) @db.Uuid
  profileId              String        @db.Uuid
  workspaceType          WorkspaceType
  workspaceId            String        @db.Uuid
  createdByUserId        String        @db.Uuid
  jobTitle               String
  company                String
  rawJD                  String
  parsedKeywords         Json?
  parsedRequirements     Json?
  parsedResponsibilities Json?
  experienceLevel        String?
  roleType               String?
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  resumes   Resume[]

  @@index([workspaceId])
  @@index([profileId])
}

model Resume {
  id              String        @id @default(uuid()) @db.Uuid
  profileId       String        @db.Uuid
  ownerUserId     String        @db.Uuid
  workspaceType   WorkspaceType
  workspaceId     String        @db.Uuid
  createdByUserId String        @db.Uuid
  jdHistoryId     String?       @db.Uuid
  templateId      String?
  content         Json?
  atsBreakdown    Json?
  atsScore        Float?
  pdfR2Key        String?
  currentVersion  Int           @default(1)
  status          String        @default("draft")
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  profile   UserProfile     @relation(fields: [profileId], references: [id], onDelete: Restrict)
  jdHistory JDHistory?      @relation(fields: [jdHistoryId], references: [id], onDelete: Restrict)
  versions  ResumeVersion[]
  taskRuns  TaskRun[]

  @@index([workspaceId])
  @@index([profileId])
}

model ResumeVersion {
  id              String   @id @default(uuid()) @db.Uuid
  resumeId        String   @db.Uuid
  versionNumber   Int
  content         Json
  atsBreakdown    Json?
  atsScore        Float?
  pdfR2Key        String?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  searchChunks ResumeSearchChunk[]

  @@unique([resumeId, versionNumber])
}

model TaskRun {
  id             String        @id @default(uuid()) @db.Uuid
  runId          String?       @unique
  profileId      String        @db.Uuid
  workspaceType  WorkspaceType
  workspaceId    String        @db.Uuid
  userId         String        @db.Uuid
  resumeId       String?       @db.Uuid
  kind           String        @default("generation")
  dispatchStatus String        @default("pending")
  idempotencyKey String?       @unique
  attempt        Int           @default(1)
  errorCode      String?
  inputRevisions Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  resume    Resume?   @relation(fields: [resumeId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([profileId])
}

// Private, derived cache. SQL migration owns RLS and the cosine HNSW index.
model ResumeSearchChunk {
  id String @id @default(uuid()) @db.Uuid
  versionId String @db.Uuid
  resumeId String @db.Uuid
  ownerUserId String @db.Uuid
  workspaceId String @db.Uuid
  sectionId String
  itemId String
  model String
  dimensions Int
  projectionVersion String
  sourceHash String
  text String
  embedding Unsupported("vector(768)")
  generatedAt DateTime @default(now()) @db.Timestamptz(3)
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  @@unique([versionId, sectionId, itemId, model, projectionVersion])
  @@index([ownerUserId, workspaceId, resumeId, versionId])
}

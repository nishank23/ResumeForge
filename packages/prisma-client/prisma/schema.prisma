generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  individual
  organization
  vendor
}

enum OAuthProvider {
  google
  linkedin
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  name              String?
  avatarUrl         String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  accounts          OAuthAccount[]
  sessions          Session[]
  profile           UserProfile?
  personalWorkspace Workspace?
}

model OAuthAccount {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  provider        OAuthProvider
  providerSubject String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshHash  String    @unique @db.Char(64)
  familyId     String    @db.Uuid
  replacedById String?   @unique @db.Uuid
  replacement  Session?  @relation("Rotation", fields: [replacedById], references: [id], onDelete: Restrict)
  previous     Session?  @relation("Rotation")
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model Workspace {
  id                  String                  @id @default(uuid()) @db.Uuid
  type                WorkspaceType
  personalOwnerUserId String?                 @unique @db.Uuid
  personalOwner       User?                   @relation(fields: [personalOwnerUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  grants              ProfileWorkspaceGrant[]
}

model UserProfile {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @unique @db.Uuid
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  fullName              String
  location              String?
  professionalSummary   String?
  revision              Int                     @default(1)
  onboardingCompletedAt DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  contact               UserContact?
  grants                ProfileWorkspaceGrant[]

  @@unique([id, userId])
}

model UserContact {
  id           String      @id @default(uuid()) @db.Uuid
  profileId    String      @unique @db.Uuid
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  email        String?
  phone        String?
  address      String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
}

model ProfileWorkspaceGrant {
  id              String      @id @default(uuid()) @db.Uuid
  profileId       String      @db.Uuid
  workspaceId     String      @db.Uuid
  grantedByUserId String      @db.Uuid
  profile         UserProfile @relation(fields: [profileId, grantedByUserId], references: [id, userId], onDelete: Restrict)
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  canReadProfile  Boolean     @default(false)
  canWriteProfile Boolean     @default(false)
  canReadContact  Boolean     @default(false)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?   @db.Timestamptz(3)

  @@unique([profileId, workspaceId])
  @@index([workspaceId, revokedAt, profileId])
}

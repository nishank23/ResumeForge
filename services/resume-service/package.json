{
  "name": "@resume-forge/resume-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "node --experimental-strip-types --test test/extractor.test.mjs test/parser.test.mjs test/pdf-text.test.mjs test/route.test.mjs test/jd-parser.test.mjs test/generator.test.mjs test/gap-analyzer.test.mjs test/upload.test.mjs test/pdf-export.test.mjs",
    "test:db": "node --test test/resume.test.mjs test/jd.test.mjs test/generator.db.test.mjs test/gap-analysis.db.test.mjs",
    "test:editor:db": "node --experimental-strip-types --test test/editor.db.test.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@hono/node-server": "^1.13.7",
    "@react-pdf/renderer": "4.9.0",
    "@resume-forge/access-policy": "workspace:*",
    "@resume-forge/audit-contracts": "workspace:*",
    "@resume-forge/prisma-client": "workspace:*",
    "@resume-forge/shared-types": "workspace:*",
    "hono": "^4.7.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0"
  }
}
